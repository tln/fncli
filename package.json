  "license": "MIT",
  "engines": {
    "node": ">= 6.0.0"
  },
  "repository": "tln/fncli",
  "devDependencies": {
    "embedme": "^1.22.1",
    "mocha": "^7.1.0"
  },
  "dependencies": {
    "acorn": "^8.10.0",
    "picocolors": "^1.1.1",
    "shell-complete": "^0.2.0"
  }
}
